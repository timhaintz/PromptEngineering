# Copy to a private .env file. Never commit populated credentials.
# Values ending in _MODEL are Azure deployment names, not necessarily model IDs.
AZUREVSEASTUS2_OPENAI_ENDPOINT=
AZUREVSEASTUS2_OPENAI_KEY=
AZUREVSEASTUS2_OPENAI_GPT41_MODEL=
AZUREVSEASTUS2_OPENAI_GPT52_MODEL=
AZUREVSEASTUS2_GROK4_FAST_REASONING_MODEL=
AZUREVSEASTUS2_OPENAI_GPT61SOL_MODEL=
AZUREVSEASTUS2_OPENAI_GPT6LUNA_MODEL=
AZUREVSEASTUS2_GROK47_MODEL=
AZUREVSEASTUS2_OPENAI_GPT6ASTRA_MODEL=

# Historical DeepSeek configuration uses a separate resource.
AZUREVS_OPENAI_GPT45PREVIEW_ENDPOINT=
AZUREVS_OPENAI_GPT45PREVIEW_KEY=
AZUREVS_DEEPSEEK_R1_0528_MODEL=

# Optional tenant for Microsoft Entra authentication instead of API keys.
AZURE_TENANT_ID=
